# Variáveis de ambiente do Ablaw IA.
# Nenhum valor real deve ser commitado. O projeto Supabase real já existe
# (projeto "jwaablow-ux's Project", ref xpniagdddnfjcdutamnx) — os valores reais
# ficam só no .env local (gitignored) e nas envs da Vercel.
# Este projeto usa o sistema novo de chaves do Supabase: VITE_SUPABASE_ANON_KEY
# recebe a "publishable key" (sb_publishable_...), que substitui a antiga anon key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
